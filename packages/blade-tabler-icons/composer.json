{
    "name": "superbyte/blade-tabler-icons",
    "description": "All 6,184 Tabler Icons (outline & filled) as Blade components for Laravel and Livewire apps.",
    "keywords": ["laravel", "livewire", "blade", "icons", "svg", "tabler"],
    "homepage": "https://github.com/superbyte23/blade-tabler-icons",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "John Canete",
            "homepage": "https://github.com/superbyte23"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "blade-ui-kit/blade-icons": "^1.6"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Superbyte\\BladeTablerIcons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Superbyte\\BladeTablerIcons\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Superbyte\\BladeTablerIcons\\BladeTablerIconsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
